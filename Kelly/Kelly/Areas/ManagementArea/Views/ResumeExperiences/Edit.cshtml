@model ResumeExperience

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Özgeçmiş Sayfası Deneyimleri Düzenle</h1>
            <a asp-area="ManagementArea" asp-controller="ResumeExperiences" asp-action="Index" class=" btn btn-warning" style="float:right;">Geri</a>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                @Html.HiddenFor(x => x.Id)

                <div asp-validation-summary="ModelOnly" style="color:red;"></div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Title"></label>
                    <input type="text" class="form-control" asp-for="Title" />
                    <span asp-validation-for="Title" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Position"></label>
                    <input type="text" class="form-control" asp-for="Position" />
                    <span asp-validation-for="Position" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="StartYear"></label>
                    <input type="date" class="form-control" asp-for="StartYear" />
                    <span asp-validation-for="StartYear" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="EndYear"></label>
                    <input type="date" class="form-control" asp-for="EndYear" />
                    <span asp-validation-for="EndYear" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Company"></label>
                    <input type="text" class="form-control" asp-for="Company" />
                    <span asp-validation-for="Company" style="color:red;"></span>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>
        </div>
    </div>
</div>
