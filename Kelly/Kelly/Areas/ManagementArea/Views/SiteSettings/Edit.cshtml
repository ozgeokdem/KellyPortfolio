@model SiteSetting

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Site Ayarları Düzenle</h1>
            <a asp-area="ManagementArea" asp-controller="SiteSettings" asp-action="Index" class=" btn btn-warning" style="float:right;">Geri</a>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @Html.HiddenFor(x => x.Id)
                @Html.HiddenFor(x => x.LogoUrl)

                <div asp-validation-summary="ModelOnly" style="color:red;"></div>

                <div class="mb-6">
                    <label class="form-label" asp-for="CopyTitle"></label>
                    <input type="text" class="form-control" asp-for="CopyTitle" />
                    <span asp-validation-for="CopyTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="DesignTitle"></label>
                    <input type="text" class="form-control" asp-for="DesignTitle" />
                    <span asp-validation-for="DesignTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="InstagramUrl"></label>
                    <input type="text" class="form-control" asp-for="InstagramUrl" />
                    <span asp-validation-for="InstagramUrl" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="FacebookUrl"></label>
                    <input type="text" class="form-control" asp-for="FacebookUrl" />
                    <span asp-validation-for="FacebookUrl" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="TwitterUrl"></label>
                    <input type="text" class="form-control" asp-for="TwitterUrl" />
                    <span asp-validation-for="TwitterUrl" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="LinkedinUrl"></label>
                    <input type="text" class="form-control" asp-for="LinkedinUrl" />
                    <span asp-validation-for="LinkedinUrl" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="LogoUrl"></label>
                    <input type="file" class="form-control" name="img" />
                    <span asp-validation-for="LogoUrl" style="color:red;"></span>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>
        </div>
    </div>
</div>
