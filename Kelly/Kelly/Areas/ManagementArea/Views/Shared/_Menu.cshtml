                </svg>
            </span>
            <span class="app-brand-text demo menu-text fw-bolder ms-2">Sneat</span>
        </a>

        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
            <i class="bx bx-chevron-left bx-sm align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">
        
        <li class="menu-item @(isHome ? "active" : "" )">
            <a asp-area="ManagementArea" asp-controller="Home" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-home-circle"></i>
                <div>Dashboard</div>
            </a>
        </li>
        
        <li class="menu-item @(isHomePages ? "active" : "")">
            <a asp-area="ManagementArea" asp-controller="HomePages" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-home"></i>
                <div>Anasayfa</div>
            </a>
        </li>

        <li class="menu-item @(isAboutMenu ? "active open" : "")">
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon tf-icons bx bx-user"></i>
                <div>Hakkımızda</div>
            </a>

            <ul class="menu-sub">

                <li class="menu-item @(isAboutPages ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="AboutPages" asp-action="Index" class="menu-link">
                        <div>Sayfa</div>
                    </a>
                </li>

                <li class="menu-item @(isAboutFacts ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="AboutFacts" asp-action="Index" class="menu-link">
                        <div>Hakkımızda Gerçekler</div>
                    </a>
                </li>

                <li class="menu-item @(isAboutSkills ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="AboutSkills" asp-action="Index" class="menu-link">
                        <div>Hakkımızda Beceriler</div>
                    </a>
                </li>
            </ul>
            </li>

            
        <li class="menu-item @(isResumeMenu ? "active open" : "")">
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon tf-icons bx bx-file"></i>
                <div>Özgeçmiş</div>
            </a>

            <ul class="menu-sub">

                <li class="menu-item @(isResumePages ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="ResumePages" asp-action="Index" class="menu-link">
                        <div>Özgeçmiş</div>
                    </a>
                </li>

                <li class="menu-item @(isResumeSumary ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="ResumeSumaries" asp-action="Index" class="menu-link">
                        <div>Özet</div>
                    </a>
                </li>

                <li class="menu-item @(isResumeEducation ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="ResumeEducations" asp-action="Index" class="menu-link">
                        <div>Eğitimler</div>
                    </a>
                </li>

                <li class="menu-item @(isResumeExperience ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="ResumeExperiences" asp-action="Index" class="menu-link">
                        <div>Deneyimler</div>
                    </a>
                </li>

                <li class="menu-item @(isResumeExperienceItems ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="ResumeExperienceItems" asp-action="Index" class="menu-link">
                        <div>Deneyim Detayı</div>
                    </a>
                </li>
            </ul>
        </li>

        <li class="menu-item @(isServiceMenu ? "active open" : "")">
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon tf-icons bx bx-briefcase-alt-2"></i>
                <div>Hizmetler</div>
            </a>

            <ul class="menu-sub">
                
                <li class="menu-item @(isServicePages ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="ServicePages" asp-action="Index" class="menu-link">
                        <div>Sayfa</div>
                    </a>
                </li>

                <li class="menu-item @(isServiceCards ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="ServiceCards" asp-action="Index" class="menu-link">
                        <div>Kartlar</div>
                    </a>
                </li>
            </ul>
            </li>

        <li class="menu-item @(isPrtfolioMenu ? "active open" : "")">
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon tf-icons bx bx-images"></i>
                <div>Portföy</div>
            </a>

            <ul class="menu-sub">
                <li class="menu-item @(isPortfolioPages ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="PortfolioPages" asp-action="Index" class="menu-link">
                        <div>Portfolio Sayfası</div>
                    </a>
                </li>

                
                <li class="menu-item @(isPortfolioPagePortfolio ? "active" : "")">
                    <a asp-area="ManagementArea" asp-controller="PortfolioPagePortfolio" asp-action="Index" class="menu-link">
                        <div>Portfolio Sayfası Portfolyosu</div>
                    </a>
                </li>
            </ul>
        </li>

            <li class="menu-item @(isContactMenu ? "active open" : "")">
                <a href="javascript:void(0);" class="menu-link menu-toggle">
                    <i class="menu-icon tf-icons bx bx-envelope"></i>
                    <div>İletişim</div>
                </a>

                <ul class="menu-sub">

                    <li class="menu-item @(isContactPages ? "active" : "")">
                        <a asp-area="ManagementArea" asp-controller="ContactPages" asp-action="Index" class="menu-link">
                            <div>İletişim Sayfası</div>
                        </a>
                    </li>
                    
                    <li class="menu-item @(isContactMessages ? "active" : "")">
                        <a asp-area="ManagementArea" asp-controller="ContactMessages" asp-action="Index" class="menu-link">
                            <div>İletişim Mesajları</div>
                        </a>
                    </li>
                </ul>
                </li>

        <li class="menu-item @(isTestimonials ? "active" : "")">
            <a asp-area="ManagementArea" asp-controller="Testimonials" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-message-rounded-detail"></i>
                <div>Müşteri Yorumları</div>
            </a>
        </li>

        @if (User.FindFirst(ClaimTypes.Role)?.Value == "Admin")
        {
            <li class="menu-item @(isUsers ? "active" : "")">
                <a asp-area="ManagementArea" asp-controller="Users" asp-action="Index" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-group"></i>
                    <div>Kullanıcılar</div>
                </a>
            </li>
        }

        <li class="menu-item @(isSiteSettings ? "active" : "")">
            <a asp-area="ManagementArea" asp-controller="SiteSettings" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-cog"></i>
                <div>Site Ayarları</div>
            </a>
        </li>

    </ul>
</aside>
