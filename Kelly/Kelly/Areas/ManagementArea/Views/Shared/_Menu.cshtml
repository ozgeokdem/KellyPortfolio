@using System.Security.Claims
@using Kelly.Areas.ManagementArea.Controllers
@{
    string controllerName = ViewContext.RouteData?.Values["controller"]?.ToString() ?? "";

    bool isAboutFacts = string.Equals(controllerName, "AboutFacts", StringComparison.OrdinalIgnoreCase);

    bool isAboutPages = string.Equals(controllerName, "AboutPages", StringComparison.OrdinalIgnoreCase);

    bool isAboutSkills = string.Equals(controllerName, "AboutSkills", StringComparison.OrdinalIgnoreCase);

    bool isContactMessages = string.Equals(controllerName, "ContactMessages", StringComparison.OrdinalIgnoreCase);

    bool isContactPages = string.Equals(controllerName, "ContactPages", StringComparison.OrdinalIgnoreCase);

    bool isHome = string.Equals(controllerName, "Home", StringComparison.OrdinalIgnoreCase);

    bool isHomePages = string.Equals(controllerName, "HomePages", StringComparison.OrdinalIgnoreCase);

    bool isPortfolioPagePortfolio = string.Equals(controllerName, "PortfolioPagePortfolio", StringComparison.OrdinalIgnoreCase);

    bool isPortfolioPages = string.Equals(controllerName, "PortfolioPages", StringComparison.OrdinalIgnoreCase);

    bool isResumeSumary = string.Equals(controllerName, "ResumeSumaries", StringComparison.OrdinalIgnoreCase);

    bool isResumeEducation = string.Equals(controllerName, "ResumeEducations", StringComparison.OrdinalIgnoreCase);

    bool isResumeExperience = string.Equals(controllerName, "ResumeExperiences", StringComparison.OrdinalIgnoreCase);

    bool isResumePages = string.Equals(controllerName, "ResumePages", StringComparison.OrdinalIgnoreCase);

    bool isServiceCards = string.Equals(controllerName, "ServiceCards", StringComparison.OrdinalIgnoreCase);

    bool isServicePages = string.Equals(controllerName, "ServicePages", StringComparison.OrdinalIgnoreCase);

    bool isSiteSettings = string.Equals(controllerName, "SiteSettings", StringComparison.OrdinalIgnoreCase);

    bool isTestimonials = string.Equals(controllerName, "Testimonials", StringComparison.OrdinalIgnoreCase);

    bool isUsers = string.Equals(controllerName, "Users", StringComparison.OrdinalIgnoreCase);

    bool isResumeExperienceItems = string.Equals(controllerName, "ExperienceItems", StringComparison.OrdinalIgnoreCase);

    bool isAboutMenu =
         isAboutPages ||
         isAboutSkills ||
         isAboutFacts;

    bool isResumeMenu =
         isResumePages ||
         isResumeSumary ||
         isResumeEducation ||
         isResumeExperience ||
         isResumeExperienceItems;

    bool isPrtfolioMenu =
         isPortfolioPages ||
         isPortfolioPagePortfolio;

    bool isServiceMenu =
         isServicePages ||
         isServiceCards;

    bool isContactMenu =
         isContactPages ||
         isContactMessages;
}


<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
    <div class="app-brand demo">
        <a href="index.html" class="app-brand-link">
            <span class="app-brand-logo demo">
                <svg width="25"
                     viewBox="0 0 25 42"
