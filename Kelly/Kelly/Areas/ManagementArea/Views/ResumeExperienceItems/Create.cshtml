@model ResumeExperienceItem

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Özgeçmiş Deneyim Ekle</h1>
            <a asp-area="ManagementArea" asp-controller="ResumeExperienceItems" asp-action="Index" class=" btn btn-warning" style="float:right;">Geri</a>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" style="color:red;"></div>

                <div class="mb-3">
                    <label class="form-label">Deneyim</label>

                    <select asp-for="ResumeExperienceId" class="form-select" asp-items="ViewBag.Experiences">
                        <option value="">Deneyim Seçiniz</option>
                    </select>

                    <span asp-validation-for="ResumeExperienceId" class="text-danger"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Responsibility"></label>
                    <textarea class="form-control" asp-for="Responsibility"></textarea>
                    <span asp-validation-for="Responsibility" style="color:red;"></span>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>
        </div>
    </div>
</div>
