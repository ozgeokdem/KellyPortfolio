@model PortfolioPage

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Portfolio Sayfası</h1>
            <a asp-area="ManagementArea" asp-controller="PortfolioPages" asp-action="Edit" class=" btn btn-warning" style="float:right;">Düzenle</a>
        </div>

        <div class="card-body">

            <div class="mb-6">
                <h5>PageTitle</h5>
                <p>@Model.PageTitle</p>
            </div>

            <div class="mb-6">
                <h5>PageDescription</h5>
                <p>@Model.PageDescription</p>
            </div>
        </div>
    </div>
</div>
