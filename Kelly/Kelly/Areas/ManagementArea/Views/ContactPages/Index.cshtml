@model ContactPage

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">İletişim Sayfası</h1>
            <a asp-area="ManagementArea" asp-controller="ContactPages" asp-action="Edit" class=" btn btn-warning" style="float:right;">Düzenle</a>
        </div>

        <div class="card-body">

            <div class="mb-6">
                <h5>PageTitle</h5>
                <p>@Model.PageTitle</p>
            </div>

            <div class="mb-6">
                <h5>PageDescription</h5>
                <p>@Model.PageDescription</p>
            </div>

            <div class="mb-6">
                <h5>Card1IconClass</h5>
                <p>@Model.Card1IconClass</p>
            </div>

            <div class="mb-6">
                <h5>Card1Title</h5>
                <p>@Model.Card1Title</p>
            </div>

            <div class="mb-6">
                <h5>Card1Description</h5>
                <p>@Model.Card1Description</p>
            </div>

            <div class="mb-6">
                <h5>Card2IconClass</h5>
                <p>@Model.Card2IconClass</p>
            </div>

            <div class="mb-6">
                <h5>Card2Title</h5>
                <p>@Model.Card2Title</p>
            </div>

            <div class="mb-6">
                <h5>Card2Description</h5>
                <p>@Model.Card2Description</p>
            </div>

            <div class="mb-6">
                <h5>Card3IconClass</h5>
                <p>@Model.Card3IconClass</p>
            </div>

            <div class="mb-6">
                <h5>Card3Title</h5>
                <p>@Model.Card3Title</p>
            </div>

            <div class="mb-6">
                <h5>Card3Description</h5>
                <p>@Model.Card3Description</p>
            </div>

            <div class="mb-6">
                <h5>FormName</h5>
                <p>@Model.FormName</p>
            </div>

            <div class="mb-6">
                <h5>FormEmail</h5>
                <p>@Model.FormEmail</p>
            </div>

            <div class="mb-6">
                <h5>FormSubject</h5>
                <p>@Model.FormSubject</p>
            </div>

            <div class="mb-6">
                <h5>FormMessage</h5>
                <p>@Model.FormMessage</p>
            </div>

            <div class="mb-6">
                <h5>FormButtonTitle</h5>
                <p>@Model.FormButtonTitle</p>
            </div>
        </div>
    </div>
</div>
