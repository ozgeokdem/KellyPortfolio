@model IEnumerable<PortfolioItemImage>
@{
    Guid id = ViewData["Id"] != null ? (Guid)ViewData["Id"] : Guid.Empty;
}

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Portfolio Öğesi Resimleri</h1>
            <a asp-area="ManagementArea"
               asp-controller="PortfolioItemImages"
               asp-action="Create" asp-route-id="@id" class="btn btn-primary" style="float:right;">Yeni Ekle</a>
        </div>

        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Görsel</th>
                            <th>Alternatif Metin</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" width="100" />
                                </td>
                                <td>@item.ImageAlt</td>
                            
                                <td>
                                    <button onclick="Delete('@(item.Id)', this)" class="btn btn-danger"><i class="icon-base bx bx-trash me-1"></i> Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section PageScripts{
    <script>
        function Delete(id, elem){
            $.ajax({
                url: "/ManagementArea/PortfolioItemImages/Delete/" + id,
                method: "post",
                data: {},
                success: function(e){
                    if(e.success == true){
                        $(elem).closest("tr").remove();
                    }
                    else{
                        alert(e.Message);
                    }
                },
                error: function(e){
                    alert("Bir sorun oluştu!");
                }
            })
        }
    </script>
}