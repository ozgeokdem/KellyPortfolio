@model PortfolioItemImage

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Portfolio Öğesi Yeni Resim Ekle</h1>
            <a asp-area="ManagementArea" asp-controller="PortfolioItemImages" asp-action="Index" asp-route-id="@Model.PortfolioItemId" class=" btn btn-warning" style="float:right;">Geri</a>
        </div>
        <div class="card-body">
            <form asp-action="Create" asp-route-portfolioItem="@Model.PortfolioItemId" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @Html.HiddenFor(x => x.Id)

                <div asp-validation-summary="ModelOnly" style="color:red;"></div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ImageAlt"></label>
                    <input type="text" class="form-control" asp-for="ImageAlt" />
                    <span asp-validation-for="ImageAlt" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ImageUrl"></label>
                    <input type="file" class="form-control" name="img" accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="ImageUrl" style="color:red;"></span>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>
        </div>
    </div>
</div>
