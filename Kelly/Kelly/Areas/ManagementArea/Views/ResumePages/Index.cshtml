@model ResumePage

<div class="col-12">
    <div class="card">
        
        <div class="card-header">
            <h1 style="display:inline-block;">Özgeçmiş</h1>
            <a asp-area="ManagementArea" asp-controller="ResumePages" asp-action="Edit" class=" btn btn-warning" style="float:right;" >Düzenle</a>
        </div>

        <div class="card-body">

            <div class="mb-2">
                 <h3>Sayfa Başlığı</h3>
                 <p>@Model.PageTitle</p>
            </div>

            <div class="mb-2">
                <h3>Sayfa Açıklaması</h3>
                <p>@Model.PageDescription</p>
            </div>

        </div>
    </div>
</div>