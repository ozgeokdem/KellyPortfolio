@model AboutFact

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Hizmet Gerçekleri Ekle</h1>
            <a asp-area="ManagementArea" asp-controller="AboutFacts" asp-action="Index" class=" btn btn-warning" style="float:right;">Geri</a>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" style="color:red;"></div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Name"></label>
                    <input type="text" class="form-control" asp-for="Name" />
                    <span asp-validation-for="Name" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Number"></label>
                    <input type="number" class="form-control" asp-for="Number" />
                    <span asp-validation-for="Number" style="color:red;"></span>
                </div>
                
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>
        </div>
    </div>
</div>
