@model PortfolioItem

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Hizmet Kartı Düzenle</h1>
            <a asp-area="ManagementArea" asp-controller="PortfolioPagePortfolio" asp-action="Index" class=" btn btn-warning" style="float:right;">Geri</a>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @Html.HiddenFor(x => x.Id)

                <div asp-validation-summary="ModelOnly" style="color:red;"></div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Title"></label>
                    <input type="text" class="form-control" asp-for="Title" />
                    <span asp-validation-for="Title" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectCategory"></label>
                    <input type="text" class="form-control" asp-for="ProjectCategory" />
                    <span asp-validation-for="ProjectCategory" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectClient"></label>
                    <input type="text" class="form-control" asp-for="ProjectClient" />
                    <span asp-validation-for="ProjectClient" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectDate"></label>
                    <input type="date" class="form-control" asp-for="ProjectDate" />
                    <span asp-validation-for="ProjectDate" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectUrl"></label>
                    <input type="text" class="form-control" asp-for="ProjectUrl" />
                    <span asp-validation-for="ProjectUrl" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="Description"></label>
                    <input type="text" class="form-control" asp-for="Description" />
                    <span asp-validation-for="Description" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ImageUrl"></label>
                    <input type="file" class="form-control" name="img" />
                    <span asp-validation-for="ImageUrl" style="color:red;"></span>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>
        </div>
    </div>
</div>
