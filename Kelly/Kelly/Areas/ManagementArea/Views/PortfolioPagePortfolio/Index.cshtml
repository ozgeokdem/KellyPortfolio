@model IEnumerable<PortfolioItem>

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Portfolio Sayfası Portfolyosu</h1>
            <a asp-area="ManagementArea"
               asp-controller="PortfolioPagePortfolio"
               asp-action="Create" class="btn btn-primary" style="float:right;">Yeni Ekle</a>
        </div>

        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Başlık</th>
                            <th>Proje Kategorisi</th>
                            <th>Müşteri</th>
                            <th>Proje Kategorisi</th>
                            <th>Proje URL</th>
                            <th>Açıklama</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                
                                <td>@item.Title</td>
                                <td>@item.ProjectCategory</td>
                                <td>@item.ProjectClient</td>
                                <td>@item.ProjectDate</td>
                                <td>@item.ProjectUrl</td>
                                <td>@item.Description</td>

                                <td>

                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id"><i class="icon-base bx bx-pencil me-1"></i>Düzenle</a>

                                    <a class="btn btn-warning" asp-area="ManagementArea" asp-controller="PortfolioItemImages" asp-action="Index" asp-route-id="@item.Id"><i class="icon-base bx bx-photo-album me-1"></i>Portfolio</a>

                                    <button onclick="Delete('@(item.Id)', this)" class="btn btn-danger"><i class="icon-base bx bx-trash me-1"></i> Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section PageScripts {
    <script>
        function Delete(id, elem){
            $.ajax({
                url: "/ManagementArea/PortfolioPagePortfolio/Delete/" + id,
                method: "post",
                data: {},
                success: function(e){
                    if(e.status == true){
                        $(elem).closest("tr").remove();
                    }
                    else{
                        alert(e.Message);
                    }
                },
                error: function(e){
                    alert("Bir sorun oluştu!");
                }
            })
        }
    </script>
}