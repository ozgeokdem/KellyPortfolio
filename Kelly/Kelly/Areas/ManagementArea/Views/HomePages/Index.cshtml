@model HomePage

<div class="col-12">
    <div class="card">
        
        <div class="card-header">
            <h1 style="display:inline-block;">Anasayfa</h1>
            <a asp-area="ManagementArea" asp-controller="HomePages" asp-action="Edit" class=" btn btn-warning" style="float:right;" >Düzenle</a>
        </div>

        <div class="card-body">

            <div class="mb-2">
                 <h3>Sayfa Başlığı</h3>
                 <p>@Model.PageTitle</p>
            </div>

            <div class="mb-2">
                <h3>Sayfa Açıklaması</h3>
                <p>@Model.PageDescription</p>
            </div>

            <div class="mb-2">
                <h3>Buton Metni</h3>
                <p>@Model.PageButtonTitle</p>
            </div>

            <div class="mb-2">
                <h3>Buton Url</h3>
                <p>@Model.PageButtonUrl</p>
            </div>

            <div class="mb-2">
                <h3>Ana Sayfa Görseli</h3>
                <img src="@Model.ImageUrl" width="100px" />
            </div>

        </div>
    </div>
</div>