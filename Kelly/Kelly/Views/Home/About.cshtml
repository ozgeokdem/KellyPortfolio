@model AboutPage

<!-- About Section -->
<section id="about" class="about section">

    @await Html.PartialAsync("_SectionTitle",
    new SectionTitleVM
    {
                Title = "Hakkımda",
                Description = "Beni ve yazılım yolculuğumu tanıyabilirsiniz."
            })

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4 justify-content-center">
            <div class="col-lg-4">
                <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.PageTitle">
            </div>
            <div class="col-lg-8 content">
                <h2>@Model.AboutTitle</h2>
                <p class="fst-italic py-3">
                    @Model.AboutDescription
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Birthday:</strong> <span>@Model.AboutBirthday?.ToString("dd/MM/yyyy")</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Website:</strong> <span>@Model.AboutWebsite</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Phone:</strong> <span>@Model.AboutPhoneNumber</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>City:</strong> <span>@Model.AboutCity</span></li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Age:</strong> <span>@Model.AboutAge</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Degree:</strong> <span>@Model.AboutDegree</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Email:</strong> <span>@Model.AboutEmail</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Freelance:</strong> <span>
                                @if(Model.AboutFreelance == true)
                                    {
                                        <text>Uygun</text>
                                    }
                                    else
                                    {
                                        <text>Uygun Değil</text>
                                    }
                                </span></li>
                        </ul>
                    </div>
                </div>
                <p class="py-3">
                    @Html.Raw(Model.AboutContent)
                </p>
            </div>
        </div>

    </div>

</section><!-- /About Section -->
<!-- Skills Section -->
<section id="skills" class="skills section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>@Model.SkillsUpperTitle</h2>
        <p>@Model.SkillsTitle</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        @{
            var middle = (int)Math.Ceiling(Model.AboutSkills.Count / 2.0);

            var leftSkills = Model.AboutSkills.Take(middle);
            var rightSkills = Model.AboutSkills.Skip(middle);
        }

        <div class="row skills-content skills-animation">

            <div class="col-lg-6">

                @foreach (var item in leftSkills)
                {
                    <div class="progress">
                        <span class="skill"><span>@item.Name</span> <i class="val">@item.Percentage%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="@item.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div><!-- End Skills Item -->
                }

            </div>

            <div class="col-lg-6">
                @foreach (var item in rightSkills)
                {
                    <div class="progress">
                        <span class="skill"><span>@item.Name</span> <i class="val">@item.Percentage%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="@item.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div><!-- End Skills Item -->
                }
            </div>

        </div>

    </div>

</section><!-- /Skills Section -->
<!-- Stats Section -->
<section id="stats" class="stats section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>@Model.FactsUpperTitle</h2>
        <p>@Model.FactsTitle</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">
            @foreach (var item in Model.AboutFacts)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <span data-purecounter-start="0" data-purecounter-end="@item.Number" data-purecounter-duration="1" class="purecounter"></span>
                        <p>@item.Name</p>
                    </div>
                </div><!-- End Stats Item -->
            }
        </div>

    </div>

</section><!-- /Stats Section -->
<!-- Testimonials Section -->
<section id="testimonials" class="testimonials section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>@Model.TestimonialsUpperTitle</h2>
        <p>@Model.TestimonialsTitle</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="swiper init-swiper">
            <script type="application/json" class="swiper-config">
                            {
                              "loop": true,
                              "speed": 600,
                              "autoplay": {
                                "delay": 5000
                              },
                              "slidesPerView": "auto",
                              "pagination": {
                                "el": ".swiper-pagination",
                                "type": "bullets",
                                "clickable": true
                              }
                            }
            </script>
            <div class="swiper-wrapper">

                @foreach (var item in Model.Testimonials)
                {
                    <div class="swiper-slide">
                        <div class="testimonial-item">
                            <img src="@item.ProfilePictureUrl" class="testimonial-img" alt="@item.FullName">
                            <h3>@item.FullName</h3>
                            <h4>@item.Title</h4>
                            <div class="stars">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p>
                                <i class="bi bi-quote quote-icon-left"></i>
                                @item.Comment
                                <i class="bi bi-quote quote-icon-right"></i>
                            </p>
                        </div>
                    </div><!-- End testimonial item -->
                }

            </div>
            <div class="swiper-pagination"></div>
        </div>

    </div>

</section><!-- /Testimonials Section -->
